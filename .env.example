# ─────────────────────────────────────────────────────────────
# Nidan environment
# Copy to .env.local. The app runs fully with NONE of these set —
# every integration has a mock path and MOCK_* defaults to true.
# ─────────────────────────────────────────────────────────────

# client-visible — safe, protected by RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# server only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
MSG91_AUTH_KEY=
RESEND_API_KEY=
RAZORPAY_KEY_SECRET=
GOOGLE_MAPS_API_KEY=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# demo-day safety switches — the mock path is the default in development
MOCK_DB=true
MOCK_ABDM=true
MOCK_SMS=true
MOCK_AI=true
MOCK_OCR=true
DEMO_OTP=123456
